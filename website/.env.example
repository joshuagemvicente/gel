# Optional: serve the DMG from elsewhere (GitHub Release, Vercel Blob or R2).
# Unset: the site serves its own copy, public/Gel-macOS-arm64.dmg.
NEXT_PUBLIC_DMG_URL=

# Optional: the site's public URL, used for absolute Open Graph image links. On Vercel the production domain is used.
NEXT_PUBLIC_SITE_URL=
