{
  "id": "core",
  "name": "Core",
  "description": "Contact details, dates of birth and addresses. Always on.",
  "alwaysOn": true,
  "types": [
    {
      "id": "EMAIL",
      "label": "email address",
      "category": "contact",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"
    },
    {
      "id": "PHONE",
      "label": "phone number",
      "category": "contact",
      "pattern": "(?:\\+63[\\s-]?|(?<!\\d)0)9\\d{2}[\\s-]?\\d{3}[\\s-]?\\d{4}(?!\\d)"
    },
    {
      "id": "DOB",
      "label": "date of birth",
      "category": "date of birth",
      "group": 1,
      "pattern": "(?i)(?:date of birth|birth ?date|birthday|d\\.?o\\.?b\\.?|kapanganakan|petsa ng kapanganakan|born(?: on)?)(?:\\s*\\([^)\\n]{0,20}\\))?\\s*[:\\-]?\\s*((?:\\d{1,2}[/-]\\d{1,2}[/-]\\d{2,4})|(?:\\d{4}-\\d{2}-\\d{2})|(?:[A-Z][a-z]+\\.? \\d{1,2},? \\d{4})|(?:\\d{1,2} [A-Z][a-z]+\\.? \\d{4}))"
    },
    {
      "id": "ADDRESS",
      "label": "home address",
      "category": "address",
      "group": 1,
      "pattern": "(?i)(?:home address|present address|permanent address|address|tirahan)\\s*[:\\-]\\s*([^\\n]{8,140}?)(?=[ \\t]{2,}|[ \\t]+(?:SSS|TIN|PhilHealth|Pag-?IBIG|Tel|Mobile|Email|Contact)\\b|\\n|$)"
    },
    {
      "id": "ADDRESS",
      "label": "home address",
      "category": "address",
      "pattern": "(?i)\\b(?:Brgy\\.?|Barangay)\\s+[A-Za-z0-9 .'-]{2,40}(?:,[^\\n,]{2,40}){0,3}"
    },
    {
      "id": "NAME",
      "label": "name",
      "category": "name",
      "pattern": "\\b(?:Mr|Ms|Mrs|Dr|Engr|Atty)\\.?[ \\t]+[A-Z][A-Za-z]+(?:[ \\t]+[A-Z]\\.)?(?:[ \\t]+[A-Z][A-Za-z'-]+){1,3}"
    },
    {
      "id": "NAME",
      "label": "name",
      "category": "name",
      "group": 1,
      "pattern": "(?i)\\b(?:full name|name of employee|employee name|name|pangalan)\\s*[:\\-]\\s*([A-Za-zÑñ .'-]{4,60}?)(?=\\s{2,}|\\n|,|$)"
    },
    {
      "id": "NAME",
      "label": "name",
      "category": "name",
      "group": 1,
      "pattern": "(?i:last name|surname|first name|given name|middle name|apelyido|unang pangalan)[ \\t]*[:\\-]?[ \\t]*\\n?[ \\t]*([A-ZÑ][A-Za-zÑñ'-]+(?:[ \\t][A-ZÑ][A-Za-zÑñ'-]+){0,2})"
    },
    {
      "id": "NAME",
      "label": "name",
      "category": "name",
      "pattern": "\\b(?!(?:SSS|TIN|BIR|HMO|DOLE|HRIS|NBI|PSA|DTI|SEC|HR|ID|PH)\\b)[A-ZÑ][A-ZÑ'-]{2,}(?:[ \\t][A-ZÑ][A-ZÑ'-]{2,})?,[ \\t]+[A-ZÑ][a-zñ'-]+(?![A-Za-zñ])(?:[ \\t][A-ZÑ][a-zñ'-]+(?![A-Za-zñ]))?(?:[ \\t][A-ZÑ]\\.)?"
    },
    {
      "id": "ADDRESS",
      "label": "home address",
      "category": "address",
      "pattern": "\\b\\d{1,5}[A-Z]?(?:-[A-Z0-9]+)?[ \\t]+[A-Z][A-Za-zñÑ.'-]+(?:[ \\t][A-Z][A-Za-zñÑ.'-]+){0,3}[ \\t](?:St|Street|Ave|Avenue|Road|Rd|Blvd|Boulevard|Drive|Dr|Highway|Hwy|Extension|Ext)\\.?,?(?:[ \\t]*(?:Brgy\\.?|Barangay)[^\\n]{0,90})?"
    }
  ],
  "sampleQuestions": []
}